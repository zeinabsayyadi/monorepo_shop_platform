{
  "name": "shop-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @shop/db exec prisma generate",
    "db:migrate": "pnpm --filter @shop/db exec prisma migrate dev"
  },
  "devDependencies": {
    "turbo": "^2.10.10",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.22.0"
}
