// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  isSystemRole Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          String  @id @default(cuid())
  subject     String
  action      String
  description String?

  roles RolePermission[]

  @@unique([subject, action])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

enum Locale {
  fa
  en
}

model User {
  id              String    @id @default(cuid())
  phoneNumber     String    @unique
  phoneVerifiedAt DateTime?
  email           String?   @unique
  emailVerifiedAt DateTime?
  passwordHash    String?
  firstName       String?
  lastName        String?
  preferredLocale Locale    @default(fa)
  roleId          String
  role            Role      @relation(fields: [roleId], references: [id])
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  refreshToken     RefreshToken[]
  auditLogsAsActor AuditLog[]

  addresses Address[]
  orders    Order[]

  couponRedemptions CouponRedemption[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([userId, revoked])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  targetId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
}

model Category {
  id       String  @id @default(cuid())
  isActive Boolean @default(true)

  translations CategoryTranslation[]
  products     Product[]
}

model CategoryTranslation {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale     Locale
  name       String
  slug       String

  metaTitle       String?
  metaDescription String?

  @@unique([categoryId, locale])
  @@unique([locale, slug])
}

model Product {
  id         String    @id @default(cuid())
  sku        String    @unique
  price      Int
  salePrice  Int?
  stock      Int       @default(0)
  isActive   Boolean   @default(true)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  translations ProductTranslation[]

  orderItems OrderItem[]

  images String[] @default([])
}

model ProductTranslation {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale      Locale
  name        String
  description String?
  slug        String

  metaTitle       String?
  metaDescription String?

  @@unique([productId, locale])
  @@unique([locale, slug])
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  province   String
  city       String
  line1      String
  line2      String?
  postalCode String
  name       String?
  isDefault  Boolean @default(false)

  orders Order[]
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  addressId  String?
  address    Address?    @relation(fields: [addressId], references: [id])
  status     OrderStatus @default(PENDING)
  total      Int
  trackingNo String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  items    OrderItem[]
  payments Payment[]

  couponId         String?
  coupon           Coupon?           @relation(fields: [couponId], references: [id])
  discountAmount   Int               @default(0)
  couponRedemption CouponRedemption?
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Int
}

enum PaymentStatus {
  PENDING
  VERIFIED
  FAILED
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id])
  provider  String
  authority String?       @unique
  refId     String?
  amount    Int
  status    PaymentStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  metadata  Json?
}

enum CouponType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id              String     @id @default(cuid())
  code            String     @unique
  type            CouponType
  value           Int // percentage (0-100) or fixed Rial amount, depending on type
  minOrderTotal   Int?
  maxRedemptions  Int? // null = unlimited overall
  redemptionCount Int        @default(0)
  expiresAt       DateTime?
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  redemptions CouponRedemption[]
  orders      Order[]
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id])
  createdAt DateTime @default(now())

  @@unique([couponId, userId]) // the actual "one use per customer" guarantee
}

model Page {
  id          String    @id @default(cuid())
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  translations PageTranslation[]
}

model PageTranslation {
  id              String  @id @default(cuid())
  pageId          String
  page            Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  locale          Locale
  title           String
  slug            String
  body            String
  metaTitle       String?
  metaDescription String?

  @@unique([pageId, locale])
  @@unique([locale, slug])
}

model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(301)
  createdAt  DateTime @default(now())
}
